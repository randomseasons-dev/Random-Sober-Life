{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Random Sober Life",
  "mainBinaryName": "Random Sober Life",
  "version": "1.7.0",
  "identifier": "com.randomseasons.randomsoberlife",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Random Sober Life",
        "width": 500,
        "height": 880,
        "minWidth": 380,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#0d1512"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
